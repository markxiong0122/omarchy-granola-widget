#!/usr/bin/python3
"""List Granola notes for the Meeting Notes panel.

Usage: granola-index [limit]

Reads the API key from GRANOLA_API_KEY, or from
~/.config/omarchy-meeting-notes/granola-api-key. The key needs the Granola
Business or Enterprise plan. Prints a JSON array shaped like the output of
meeting-notes-index, plus the Granola-specific fields the panel uses
(`source`, `key`, `web_url`).

Notes and their rendered Markdown are cached in
~/.cache/omarchy-meeting-notes/granola so a panel refresh does not hit the API
for a note that has not changed. The API allows 5 requests/second; the helper
paces itself and asks for one page of recent notes.
"""
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime
from pathlib import Path

API_DEFAULT = "https://public-api.granola.ai"
LIMIT_DEFAULT = 20
MAX_LIMIT = 30
PAGE_SIZE = 100
PREVIEW_CHARS = 180
REQUEST_PAUSE = 0.22  # 5 requests/second, with a little room
TIMEOUT = 10

CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser()
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", "~/.cache")).expanduser() / "omarchy-meeting-notes" / "granola"
CONFIG_FILE = CONFIG_DIR / "omarchy-meeting-notes" / "granola.json"
KEY_FILE = CONFIG_DIR / "omarchy-meeting-notes" / "granola-api-key"
OAUTH_FILE = CONFIG_DIR / "omarchy-meeting-notes" / "granola-oauth.json"
MCP_CACHE = CACHE_DIR / "mcp-items.json"
MCP_CACHE_TTL = 300


def load_config() -> dict:
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


CONFIG = load_config()
API = (
    os.environ.get("GRANOLA_API_URL")
    or str(CONFIG.get("apiUrl") or "")
    or API_DEFAULT
).rstrip("/")


def read_key() -> str:
    key = (os.environ.get("GRANOLA_API_KEY") or "").strip()
    if key:
        return key
    configured = str(CONFIG.get("apiKey") or "").strip()
    if configured:
        return configured
    try:
        return KEY_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def api_get(path: str, params: dict | None = None) -> dict:
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    request = urllib.request.Request(
        url,
        headers={
            "Authorization": f"Bearer {key}",
            "Accept": "application/json",
            "User-Agent": "omarchy-meeting-notes/0.1",
        },
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.load(response)


def epoch(value) -> int | None:
    if not value or not isinstance(value, str):
        return None
    try:
        return int(datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp())
    except ValueError:
        return None


def clean_preview(text: str) -> str:
    text = re.sub(r"^#.*$", "", text, flags=re.MULTILINE)
    text = re.sub(r"^[-*]\s+\[[ xX]\]\s*", "", text, flags=re.MULTILINE)
    text = re.sub(r"[*_`>#]", "", text)
    text = re.sub(r"\[(.*?)\]\(.*?\)", r"\1", text)
    text = re.sub(r"\s+", " ", text).strip()
    return text[:PREVIEW_CHARS]


def transcript_text(note_id: str) -> str:
    """Fetch the transcript, a page at a time. Only used when a note has no summary."""
    lines = []
    cursor = None
    for _ in range(6):
        params = {"page_size": str(PAGE_SIZE)}
        if cursor:
            params["cursor"] = cursor
        page = api_get(f"/v1/notes/{note_id}/transcript", params)
        for item in page.get("transcript") or []:
            speaker = item.get("speaker") or {}
            name = speaker.get("name") or speaker.get("diarization_label")
            if not name:
                attribution = speaker.get("attribution")
                name = "Me" if attribution == "me" else "Them" if attribution == "them" else "Speaker"
            text = str(item.get("text") or "").strip()
            if text:
                lines.append(f"**{name}:** {text}")
        cursor = page.get("cursor")
        if not page.get("hasMore") or not cursor:
            break
        time.sleep(REQUEST_PAUSE)
    return "\n\n".join(lines)


def note_markdown(note: dict, summary: dict) -> str:
    title = str(note.get("title") or summary.get("title") or "Untitled meeting")
    calendar = note.get("calendar_event") or {}
    started = note.get("calendar_event", {}).get("scheduled_start_time") or note.get("created_at")
    meta = ["Granola"]
    if started:
        meta.append(str(started)[:16].replace("T", " "))
    attendees = []
    for attendee in note.get("attendees") or []:
        name = attendee.get("name") or attendee.get("email")
        if name:
            attendees.append(str(name))
    if attendees:
        meta.append(", ".join(attendees))

    summary_text = note.get("summary_markdown") or note.get("summary_text") or ""
    private_text = note.get("private_notes_markdown") or note.get("private_notes_text") or ""
    transcript = ""
    if not summary_text:
        try:
            transcript = transcript_text(str(note.get("id") or summary.get("id")))
        except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):
            transcript = ""

    parts = [f"# {title}", "", f"_{' · '.join(meta)}_", ""]
    if summary_text:
        parts += [summary_text.strip(), ""]
    if private_text:
        parts += ["## My notes", "", private_text.strip(), ""]
    if transcript:
        parts += ["## Transcript", "", transcript, ""]
    if not summary_text and not private_text and not transcript:
        parts += ["_This note has no summary in Granola yet._", ""]
    return "\n".join(parts)



def fix_mojibake(text: str) -> str:
    """Granola's MCP occasionally returns UTF-8 bytes decoded as Latin-1."""
    try:
        return text.encode("latin-1").decode("utf-8")
    except (UnicodeEncodeError, UnicodeDecodeError):
        return text


def clean_text(text: str) -> str:
    return html.unescape(fix_mojibake(text)).strip()


def oauth_call(tool: str, arguments: dict) -> str:
    helper = Path(__file__).with_name("granola-oauth")
    result = subprocess.run(
        ["/usr/bin/python3", str(helper), "--call", tool, json.dumps(arguments)],
        capture_output=True,
        text=True,
        timeout=90,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip() or f"{tool} failed")
    payload = json.loads(result.stdout or "{}")
    for part in payload.get("content") or []:
        if part.get("type") == "text":
            return str(part.get("text") or "")
    return ""


def attrs_of(tag: str) -> dict:
    return dict(re.findall(r'([\w-]+)="([^"]*)"', tag))


def parse_list_text(text: str) -> list[dict]:
    found = []
    for match in re.finditer(r"<meeting ([^>]*)>(.*?)</meeting>", text, re.S):
        attrs = attrs_of(match.group(1))
        body = match.group(2)
        participants = re.search(
            r"<known_participants>(.*?)</known_participants>", body, re.S
        )
        found.append(
            {
                "id": attrs.get("id", ""),
                "title": clean_text(attrs.get("title", "Untitled meeting")),
                "meeting_at": attrs.get("meeting_at", ""),
                "date": attrs.get("date", ""),
                "url": attrs.get("url", ""),
                "participants": clean_text(participants.group(1)) if participants else "",
            }
        )
    return found


def parse_detail_text(text: str) -> dict:
    details = {}
    for match in re.finditer(r"<meeting ([^>]*)>(.*?)</meeting>", text, re.S):
        attrs = attrs_of(match.group(1))
        body = match.group(2)
        summary = re.search(r"<summary>(.*?)</summary>", body, re.S)
        private = re.search(r"<private_notes[^>]*>(.*?)</private_notes>", body, re.S)
        participants = re.search(
            r"<known_participants>(.*?)</known_participants>", body, re.S
        )
        details[attrs.get("id", "")] = {
            "title": clean_text(attrs.get("title", "Untitled meeting")),
            "meeting_at": attrs.get("meeting_at", ""),
            "date": attrs.get("date", ""),
            "url": attrs.get("url", ""),
            "summary": clean_text(summary.group(1)) if summary else "",
            "private": clean_text(private.group(1)) if private else "",
            "participants": clean_text(participants.group(1)) if participants else "",
        }
    return details


def people_from(text: str) -> list[str]:
    people = []
    for part in text.split(","):
        name = part.strip().split(" from ")[0].split(" (")[0].strip()
        name = re.sub(r"\s*\(note creator\)\s*$", "", name)
        if name and name not in people:
            people.append(name)
    return people


def mcp_markdown(entry: dict) -> str:
    title = entry.get("title") or "Untitled meeting"
    meta = ["Granola"]
    if entry.get("date"):
        meta.append(str(entry["date"]))
    elif entry.get("meeting_at"):
        meta.append(str(entry["meeting_at"])[:16].replace("T", " "))
    people = people_from(entry.get("participants") or "")
    if people:
        meta.append(", ".join(people))
    parts = [f"# {title}", "", f"_{' · '.join(meta)}_", ""]
    summary = str(entry.get("summary") or "").strip()
    private = str(entry.get("private") or "").strip()
    if summary:
        parts += [summary, ""]
    if private:
        parts += ["## My notes", "", private, ""]
    if not summary and not private:
        parts += ["_This note has no summary in Granola yet._", ""]
    return "\n".join(parts)


def mcp_items(limit: int) -> list[dict]:
    if not OAUTH_FILE.is_file():
        return []
    try:
        oauth_mtime = OAUTH_FILE.stat().st_mtime
    except OSError:
        return []

    try:
        cached = json.loads(MCP_CACHE.read_text(encoding="utf-8"))
        if (
            isinstance(cached, dict)
            and time.time() - float(cached.get("fetched_at", 0)) < MCP_CACHE_TTL
            and cached.get("oauth_mtime") == oauth_mtime
            and isinstance(cached.get("items"), list)
        ):
            return cached["items"][:limit]
    except (OSError, ValueError):
        pass

    listing = oauth_call(
        "list_meetings",
        {
            "limit": min(limit, 100),
            "time_range": "last_30_days",
            "max_participants": 10,
        },
    )
    meetings = parse_list_text(listing)[:limit]
    details = {}
    for start in range(0, len(meetings), 10):
        ids = [meeting["id"] for meeting in meetings[start : start + 10] if meeting.get("id")]
        if not ids:
            continue
        try:
            details.update(
                parse_detail_text(
                    oauth_call(
                        "get_meetings",
                        {
                            "meeting_ids": ids,
                            "max_participants": 10,
                            "attachments": "none",
                        },
                    )
                )
            )
        except Exception:
            continue

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    items = []
    for meeting in meetings:
        meeting_id = str(meeting.get("id") or "")
        if not meeting_id:
            continue
        detail = details.get(meeting_id) or {}
        entry = {
            "title": detail.get("title") or meeting.get("title") or "Untitled meeting",
            "date": detail.get("date") or meeting.get("date") or "",
            "meeting_at": detail.get("meeting_at") or meeting.get("meeting_at") or "",
            "url": detail.get("url") or meeting.get("url") or f"https://notes.granola.ai/d/{meeting_id}",
            "summary": detail.get("summary") or "",
            "private": detail.get("private") or "",
            "participants": detail.get("participants") or meeting.get("participants") or "",
        }
        markdown = mcp_markdown(entry)
        note_path = CACHE_DIR / f"{meeting_id}.md"
        note_path.write_text(markdown, encoding="utf-8")
        items.append(
            {
                "key": f"granola:{meeting_id}",
                "source": "granola",
                "id": meeting_id,
                "title": entry["title"],
                "started_at": epoch(entry.get("meeting_at")),
                "duration_secs": 0,
                "speakers": people_from(entry.get("participants") or ""),
                "note_path": str(note_path),
                "note_kind": "granola",
                "preview": clean_preview(entry.get("summary") or ""),
                "has_transcript": False,
                "web_url": entry["url"],
                "dir": "",
                "name": meeting_id,
            }
        )

    items.sort(key=lambda item: (item.get("started_at") or 0, item.get("title") or ""), reverse=True)
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    MCP_CACHE.write_text(
        json.dumps(
            {"fetched_at": time.time(), "oauth_mtime": oauth_mtime, "items": items},
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )
    return items[:limit]


def main() -> int:
    global key
    key = read_key()
    limit = LIMIT_DEFAULT
    if len(sys.argv) > 1:
        try:
            limit = max(1, min(MAX_LIMIT, int(sys.argv[1])))
        except ValueError:
            pass

    if not key:
        if OAUTH_FILE.is_file():
            try:
                items = mcp_items(limit)
            except Exception as error:
                print("[]")
                print(f"Granola MCP: {error}", file=sys.stderr)
                return 0
            print(json.dumps(items, ensure_ascii=False))
            return 0
        print("[]")
        print(
            "Granola not connected; run granola-oauth --connect, or write an API key to "
            f"{KEY_FILE}",
            file=sys.stderr,
        )
        return 0

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        listing = api_get("/v1/notes", {"page_size": str(limit)})
    except urllib.error.HTTPError as error:
        print("[]")
        if error.code == 401:
            print("Granola rejected the API key", file=sys.stderr)
        elif error.code == 403:
            print("The Granola key cannot read this workspace's notes", file=sys.stderr)
        elif error.code == 429:
            print("Granola rate limit reached; try again shortly", file=sys.stderr)
        else:
            print(f"Granola returned HTTP {error.code}", file=sys.stderr)
        return 0
    except (urllib.error.URLError, TimeoutError) as error:
        print("[]")
        print(f"Could not reach Granola: {error}", file=sys.stderr)
        return 0

    items = []
    notes = listing.get("notes") or []
    for summary in notes:
        if not isinstance(summary, dict) or summary.get("deleted_at"):
            continue
        note_id = str(summary.get("id") or "")
        if not note_id:
            continue

        cache_json = CACHE_DIR / f"{note_id}.json"
        note = None
        try:
            cached = json.loads(cache_json.read_text(encoding="utf-8"))
            if isinstance(cached, dict) and cached.get("updated_at") == summary.get("updated_at"):
                note = cached
        except (OSError, ValueError):
            note = None

        if note is None:
            try:
                note = api_get(f"/v1/notes/{note_id}")
                cache_json.write_text(json.dumps(note, ensure_ascii=False), encoding="utf-8")
            except (urllib.error.URLError, urllib.error.HTTPError, TimeoutError):
                # A summary row is still useful; the note just has no body.
                note = summary
            time.sleep(REQUEST_PAUSE)

        title = str(note.get("title") or summary.get("title") or "Untitled meeting")
        calendar = note.get("calendar_event") or {}
        started = epoch(calendar.get("scheduled_start_time")) or epoch(note.get("created_at"))
        ended = epoch(calendar.get("scheduled_end_time"))
        duration = max(0, ended - started) if started and ended else 0

        markdown = note_markdown(note, summary)
        note_path = CACHE_DIR / f"{note_id}.md"
        note_path.write_text(markdown, encoding="utf-8")

        attendees = []
        for attendee in note.get("attendees") or []:
            name = attendee.get("name") or attendee.get("email")
            if name:
                attendees.append(str(name))

        summary_text = note.get("summary_markdown") or note.get("summary_text") or ""
        items.append(
            {
                "key": f"granola:{note_id}",
                "source": "granola",
                "id": note_id,
                "title": title,
                "started_at": started,
                "duration_secs": duration,
                "speakers": attendees,
                "note_path": str(note_path),
                "note_kind": "granola",
                "preview": clean_preview(summary_text),
                "has_transcript": "## Transcript" in markdown,
                "web_url": str(note.get("web_url") or ""),
                "dir": "",
                "name": note_id,
            }
        )

    items.sort(key=lambda item: (item.get("started_at") or 0, item.get("title") or ""), reverse=True)
    print(json.dumps(items, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    os.umask(0o077)
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0)
