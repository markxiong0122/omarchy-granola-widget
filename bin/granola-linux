#!/usr/bin/env bash
# Install Granola's official desktop payload on x86-64 Linux.
#
# Granola ships an Electron app for macOS and Windows, and its backend answers
# HTTP 500 to `platform=linux`, so the stock app cannot sign in from Linux. This
# builder keeps the app's JavaScript and the official Linux Electron runtime,
# reports the platform Granola accepts, and rebuilds Granola's patched SQLite
# module for Linux. No Wine, no VM, no macOS.
#
# Usage:
#   granola-linux --check
#   granola-linux                 # pinned version that can still be rebuilt
#   granola-linux --version 7.726.2
#   granola-linux --latest        # newest; may lack the SQLite source
#   granola-linux /path/to/Granola.dmg
#
# Options:
#   --dir DIR       install under DIR (default: ~/.local/share/omarchy-meeting-notes/granola)
#   --no-desktop    skip the .desktop entry and granola:// handler
#   --keep-dmg      keep the downloaded DMG in the cache
#
# Audio is the one thing this cannot prove: microphone capture uses PipeWire
# through Electron, and system audio uses Granola's Linux loopback path. Test a
# real meeting before relying on it.
#
# The conversion follows the steps documented by tirtha4/Granola-for-Linux and
# bindusara-reddy/granola-linux-macos (the latter is MIT). This script is our
# own implementation of those steps.
set -euo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-meeting-notes/granola-build"
# The newest bundles (7.749+) ship only the prebuilt Mach-O SQLite module, so
# there is no C++ source to rebuild for Linux. 7.726.2 still ships src/ and
# deps/ and is what the community package builds. Override with --version.
DEFAULT_VERSION="${GRANOLA_VERSION:-7.726.2}"
INSTALL_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-meeting-notes/granola"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
BIN_DIR="$HOME/.local/bin"
SEVENZIP_VERSION="2501"
SEVENZIP_URL="https://www.7-zip.org/a/7z${SEVENZIP_VERSION}-linux-x64.tar.xz"
LATEST_URL="https://api.granola.ai/v1/download-latest"

DMG=""
DO_DESKTOP=1
KEEP_DMG=0

say() { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*" >&2; }
die() { printf 'granola-linux: %s\n' "$*" >&2; exit 1; }

usage() {
  sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check)
      [[ -x "${INSTALL_DIR}/granola.sh" ]] && exit 0
      command -v granola >/dev/null 2>&1 && exit 0
      exit 1
      ;;
    --dir) INSTALL_DIR="${2:?--dir needs a path}"; shift 2 ;;
    --no-desktop) DO_DESKTOP=0; shift ;;
    --keep-dmg) KEEP_DMG=1; shift ;;
    --latest) DMG="latest"; shift ;;
    --version) DEFAULT_VERSION="${2:?--version needs a version}"; DMG=""; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) die "unknown option: $1" ;;
    *) DMG="$1"; shift ;;
  esac
done

[[ "$(uname -m)" == "x86_64" ]] || die "only x86-64 is supported"

for command_name in curl tar python3 node npm make sha256sum realpath; do
  command -v "$command_name" >/dev/null || die "missing $command_name"
done
node -e '
const [a,b,c] = process.versions.node.split(".").map(Number);
process.exit((a === 22 && (b > 22 || (b === 22 && c >= 2)))
  || (a === 24 && (b > 15 || (b === 15 && c >= 0)))
  || a >= 26 ? 0 : 1)
' || die "Node.js 22.22.2+, 24.15.0+, or 26+ is required"

CXX=""
for v in 15 14 13 12 11; do
  if command -v "g++-$v" >/dev/null; then CXX="g++-$v"; CC="gcc-$v"; break; fi
done
if [[ -z "$CXX" ]] && command -v g++ >/dev/null && (( $(g++ -dumpversion | cut -d. -f1) >= 11 )); then
  CXX="g++"; CC="gcc"
fi
[[ -n "$CXX" ]] || die "GCC/G++ 11 or newer is required"

WORK="$(mktemp -d "${TMPDIR:-/tmp}/granola-linux.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
mkdir -p "$CACHE_DIR"

sevenzip() {
  if [[ -n "${SEVENZZ:-}" ]]; then printf '%s' "$SEVENZZ"; return; fi
  if command -v 7zz >/dev/null; then SEVENZZ="$(command -v 7zz)"; printf '%s' "$SEVENZZ"; return; fi
  local tarball="$CACHE_DIR/7z-linux-x64.tar.xz"
  if [[ ! -f "$tarball" ]]; then
    step "Downloading 7-Zip"
    curl -fsSL -o "$tarball.part" "$SEVENZIP_URL"
    mv "$tarball.part" "$tarball"
  fi
  tar xf "$tarball" -C "$WORK" 7zz
  SEVENZZ="$WORK/7zz"
  chmod 0755 "$SEVENZZ"
  printf '%s' "$SEVENZZ"
}

plist_value() {
  sed -n "/<key>$1<\/key>/{n;s/.*<string>\([^<]*\)<\/string>.*/\1/p;q}" "$2"
}

if [[ "$DMG" == "latest" ]]; then
  step "Resolving the latest Granola DMG"
  DMG="$CACHE_DIR/Granola-latest.dmg"
  if [[ ! -f "$DMG" ]]; then
    curl -fL --retry 3 --proto '=https' --proto-redir '=https' \
      -o "$DMG.part" "$LATEST_URL"
    mv "$DMG.part" "$DMG"
  fi
elif [[ -z "$DMG" ]]; then
  step "Downloading Granola $DEFAULT_VERSION"
  DMG="$CACHE_DIR/Granola-$DEFAULT_VERSION.dmg"
  if [[ ! -f "$DMG" ]]; then
    curl -fL --retry 3 --proto '=https' --proto-redir '=https' \
      -o "$DMG.part" \
      "https://dr2v7l5emb758.cloudfront.net/$DEFAULT_VERSION/Granola-$DEFAULT_VERSION-mac-universal.dmg"
    mv "$DMG.part" "$DMG"
  fi
fi
[[ -n "$DMG" && -f "$DMG" ]] || die "usage: granola-linux [--latest | --version X | /path/to/Granola.dmg]"

SEVENZZ="$(sevenzip)"

step "Reading Granola's Electron version"
"$SEVENZZ" e "$DMG" \
  "Granola/Granola.app/Contents/Frameworks/Electron Framework.framework/Versions/A/Resources/Info.plist" \
  -o"$WORK/electron-meta" -y >/dev/null || die "cannot read the DMG"
ELECTRON_VERSION="$(plist_value CFBundleVersion "$WORK/electron-meta/Info.plist")"
[[ "$ELECTRON_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
  || die "unexpected Electron version: ${ELECTRON_VERSION:-missing}"

"$SEVENZZ" e "$DMG" "Granola/Granola.app/Contents/Info.plist" \
  -o"$WORK/app-meta" -y >/dev/null || true
GRANOLA_VERSION="$(plist_value CFBundleShortVersionString "$WORK/app-meta/Info.plist")"

step "Downloading Electron $ELECTRON_VERSION"
ELECTRON_ZIP="$CACHE_DIR/electron-v$ELECTRON_VERSION-linux-x64.zip"
if [[ ! -f "$ELECTRON_ZIP" ]]; then
  curl -fL --retry 3 -o "$ELECTRON_ZIP.part" \
    "https://github.com/electron/electron/releases/download/v$ELECTRON_VERSION/electron-v$ELECTRON_VERSION-linux-x64.zip"
  mv "$ELECTRON_ZIP.part" "$ELECTRON_ZIP"
fi

step "Extracting the payload"
rm -rf "$INSTALL_DIR"
mkdir -p "$INSTALL_DIR"
"$SEVENZZ" x "$ELECTRON_ZIP" -o"$INSTALL_DIR" -y >/dev/null
chmod 0755 "$INSTALL_DIR/electron"
rm -f "$INSTALL_DIR/resources/default_app.asar"

RES="Granola/Granola.app/Contents/Resources"
"$SEVENZZ" x "$DMG" "$RES/app.asar" "$RES/app.asar.unpacked" "$RES/icons" \
  -o"$WORK/dmg" -y >/dev/null || die "cannot extract Granola's payload"
cp -a "$WORK/dmg/$RES/app.asar" "$WORK/dmg/$RES/app.asar.unpacked" \
  "$WORK/dmg/$RES/icons" "$INSTALL_DIR/resources/"
if [[ -f "$INSTALL_DIR/resources/icons/icon.png" ]]; then
  cp "$INSTALL_DIR/resources/icons/icon.png" "$INSTALL_DIR/granola-icon.png"
elif [[ -f "$INSTALL_DIR/resources/icons/mac-icon.png" ]]; then
  cp "$INSTALL_DIR/resources/icons/mac-icon.png" "$INSTALL_DIR/granola-icon.png"
fi

step "Patching the platform Granola reports"
# api.granola.ai answers 500 to platform=linux, so report Windows. The strings
# are padded to the same byte length: app.asar records offsets in its header.
python3 - "$INSTALL_DIR/resources/app.asar" <<'PY'
import pathlib, sys
path = pathlib.Path(sys.argv[1])
data = path.read_bytes()
total = 0
for pattern in (b'?`Windows`:window.electron.platform', b'?`Windows`:process.platform'):
    replacement = b'?`Windows`:`Windows`'.ljust(len(pattern))
    total += data.count(pattern)
    data = data.replace(pattern, replacement)
if total == 0:
    sys.exit("no platform fallback found; Granola's bundle changed")
path.write_bytes(data)
print(f"    rewrote {total} platform check(s)")
PY

step "Rebuilding Granola's SQLite module for Linux"
MODULE="$INSTALL_DIR/resources/app.asar.unpacked/node_modules/better-sqlite3-multiple-ciphers"
[[ -f "$MODULE/package.json" ]] || die "Granola's SQLite module is missing"
if [[ ! -f "$MODULE/deps/common.gypi" || ! -d "$MODULE/src" ]]; then
  die "this Granola bundle ships no SQLite source (try --version 7.726.2)"
fi
VERSION="$(node -p "require('$MODULE/package.json').version")"
cp -a "$MODULE" "$WORK/module"
mkdir -p "$WORK/npm"
(cd "$WORK/npm" && npm pack "better-sqlite3-multiple-ciphers@$VERSION" --silent --ignore-scripts >/dev/null)
tar xzf "$WORK"/npm/better-sqlite3-multiple-ciphers-*.tgz -C "$WORK/npm" package/binding.gyp
cp "$WORK/npm/package/binding.gyp" "$WORK/module/binding.gyp"
(cd "$WORK/module" && CC="$CC" CXX="$CXX" npx --yes node-gyp rebuild --release \
  --runtime=electron --target="$ELECTRON_VERSION" --arch=x64 \
  --dist-url=https://electronjs.org/headers) >"$WORK/build.log" 2>&1 \
  || { tail -25 "$WORK/build.log"; die "native module build failed"; }
mkdir -p "$MODULE/build/Release"
cp "$WORK/module/build/Release/better_sqlite3.node" "$MODULE/build/Release/"
if [[ -f "$WORK/module/build/Release/test_extension.node" ]]; then
  cp "$WORK/module/build/Release/test_extension.node" "$MODULE/build/Release/"
fi

step "Installing the launcher"
cat > "$INSTALL_DIR/granola.sh" <<'SH'
#!/usr/bin/env bash
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
exec "$DIR/electron" --ozone-platform-hint=auto "$@"
SH
chmod 0755 "$INSTALL_DIR/granola.sh"
mkdir -p "$BIN_DIR"
ln -sfn "$INSTALL_DIR/granola.sh" "$BIN_DIR/granola"

if (( DO_DESKTOP )); then
  mkdir -p "$DESKTOP_DIR"
  cat > "$DESKTOP_DIR/granola.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Granola
Comment=AI notepad for back-to-back meetings
Exec=$BIN_DIR/granola %U
Icon=$INSTALL_DIR/granola-icon.png
Terminal=false
Categories=Office;Utility;
StartupWMClass=granola
MimeType=x-scheme-handler/granola;
EOF
  command -v update-desktop-database >/dev/null && \
    update-desktop-database "$DESKTOP_DIR" 2>/dev/null || true
  command -v xdg-mime >/dev/null && \
    xdg-mime default granola.desktop x-scheme-handler/granola 2>/dev/null || true
fi

if (( ! KEEP_DMG )) && [[ "$DMG" == "$CACHE_DIR/Granola-latest.dmg" ]]; then
  rm -f "$DMG"
fi

step "Installed Granola ${GRANOLA_VERSION:-unknown}"
say "    launch:  granola"
say "    binary:  $INSTALL_DIR/granola.sh"
say "    sign-in: if the browser callback does not return, copy the granola://"
say "             URL it shows into 'granola \"...\"'."
say ""
say "Audio test: start a note, play something, and confirm the other side appears"
say "in the transcript. If it does not, route a mic+monitor mix into Granola."
