#!/usr/bin/python3
"""Connect Meeting Notes to Granola over the official MCP server.

Usage:
    granola-oauth --connect     sign in with a device code (opens a browser)
    granola-oauth --status      show the connected Granola account
    granola-oauth --token       print a valid bearer token (refreshes if needed)
    granola-oauth --tools       list the MCP tools and their input schemas

The client registration and tokens live in
~/.config/omarchy-meeting-notes/granola-oauth.json. The device flow works on
Granola's Free plan (the last 30 days of notes) and on Business/Enterprise.
Nothing here writes to Granola; the MCP server is read-only.
"""
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

AUTH_BASE = "https://mcp-auth.granola.ai"
MCP_URL = "https://mcp.granola.ai/mcp"
SCOPES = "mcp offline_access"
CONFIG_DIR = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser()
CONFIG_FILE = CONFIG_DIR / "omarchy-meeting-notes" / "granola-oauth.json"
TIMEOUT = 30


def load() -> dict:
    try:
        data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save(data: dict) -> None:
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text(json.dumps(data, indent=2), encoding="utf-8")
    try:
        CONFIG_FILE.chmod(0o600)
    except OSError:
        pass


def post_form(url: str, data: dict) -> dict:
    body = urllib.parse.urlencode(data).encode()
    request = urllib.request.Request(
        url,
        data=body,
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json",
            "User-Agent": "omarchy-meeting-notes/0.1",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        return json.load(response)


def register(data: dict) -> str:
    if data.get("client_id"):
        return str(data["client_id"])
    body = {
        "client_name": "Meeting Notes for Omarchy",
        "redirect_uris": ["http://127.0.0.1:8765/callback"],
        "grant_types": [
            "authorization_code",
            "refresh_token",
            "urn:ietf:params:oauth:grant-type:device_code",
        ],
        "response_types": ["code"],
        "token_endpoint_auth_method": "none",
        "scope": SCOPES,
    }
    request = urllib.request.Request(
        AUTH_BASE + "/oauth2/register",
        data=json.dumps(body).encode(),
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "omarchy-meeting-notes/0.1",
        },
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
        result = json.load(response)
    data["client_id"] = result["client_id"]
    save(data)
    return data["client_id"]


def connect() -> int:
    data = load()
    client_id = register(data)
    device = post_form(
        AUTH_BASE + "/oauth2/device_authorization",
        {"client_id": client_id, "scope": SCOPES},
    )
    url = device.get("verification_uri_complete") or device.get("verification_uri")
    code = device.get("user_code", "")
    interval = max(2, int(device.get("interval", 5)))
    expires = time.time() + int(device.get("expires_in", 300))

    print("Open this page and approve Meeting Notes for Omarchy:", flush=True)
    print("  " + str(url), flush=True)
    if code:
        print("Code: " + str(code), flush=True)
    print("Waiting for approval…", flush=True)

    try:
        import subprocess

        subprocess.Popen(
            ["xdg-open", str(url)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except OSError:
        pass

    while time.time() < expires:
        try:
            token = post_form(
                AUTH_BASE + "/oauth2/token",
                {
                    "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
                    "device_code": device["device_code"],
                    "client_id": client_id,
                },
            )
        except urllib.error.HTTPError as error:
            payload = {}
            try:
                payload = json.load(error)
            except Exception:
                pass
            reason = str(payload.get("error", ""))
            if reason in ("authorization_pending", "slow_down"):
                time.sleep(interval)
                continue
            print(f"Granola authorization failed: {reason or error}", file=sys.stderr)
            return 1
        except (urllib.error.URLError, TimeoutError) as error:
            print(f"Could not reach Granola: {error}", file=sys.stderr)
            return 1
        data.update(token)
        data["expires_at"] = int(time.time()) + int(token.get("expires_in", 3600))
        data["client_id"] = client_id
        save(data)
        print("Connected to Granola.")
        return 0

    print("The device code expired; run --connect again.", file=sys.stderr)
    return 1


def refresh(data: dict) -> str:
    if not data.get("refresh_token"):
        raise RuntimeError("no Granola refresh token; run granola-oauth --connect")
    token = post_form(
        AUTH_BASE + "/oauth2/token",
        {
            "grant_type": "refresh_token",
            "refresh_token": data["refresh_token"],
            "client_id": data.get("client_id", ""),
        },
    )
    data.update(token)
    data["expires_at"] = int(time.time()) + int(token.get("expires_in", 3600))
    save(data)
    return str(data.get("access_token") or "")


def token() -> str:
    data = load()
    current = str(data.get("access_token") or "")
    if current and int(data.get("expires_at", 0)) > time.time() + 60:
        return current
    return refresh(data)


def parse_body(text: str) -> dict | None:
    """Parse a JSON or SSE body.

    Granola's MCP writes summary text with literal newlines inside a JSON
    string, so the payload is not strict JSON. `strict=False` accepts those
    control characters, and taking everything after `data:` to the next event
    keeps the multi-line body together.
    """
    text = text.strip()
    if not text:
        return None
    if text.startswith("{"):
        try:
            return json.loads(text, strict=False)
        except ValueError:
            return None
    for segment in re.split(r"(?m)^event:\s*", text):
        index = segment.find("data:")
        if index < 0:
            continue
        payload = segment[index + 5 :].strip()
        if not payload or payload == "[DONE]":
            continue
        try:
            data = json.loads(payload, strict=False)
        except ValueError:
            continue
        if isinstance(data, dict) and ("result" in data or "error" in data):
            return data
    return None


class Mcp:
    def __init__(self, bearer: str):
        self.token = bearer
        self.session = ""
        self.protocol = "2025-06-18"
        self.next_id = 1

    def headers(self) -> dict:
        headers = {
            "Authorization": "Bearer " + self.token,
            "Content-Type": "application/json",
            "Accept": "application/json, text/event-stream",
            "MCP-Protocol-Version": self.protocol,
            "User-Agent": "omarchy-meeting-notes/0.1",
        }
        if self.session:
            headers["Mcp-Session-Id"] = self.session
        return headers

    def post(self, body: dict) -> dict | None:
        is_notification = "id" not in body
        request = urllib.request.Request(
            MCP_URL,
            data=json.dumps(body).encode(),
            headers=self.headers(),
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
                self.session = response.headers.get("Mcp-Session-Id", self.session)
                if is_notification:
                    return None
                text = response.read().decode("utf-8", errors="replace")
        except urllib.error.HTTPError as error:
            if error.code == 401:
                raise RuntimeError("Granola MCP rejected the token")
            raise RuntimeError(f"Granola MCP HTTP {error.code}")
        except (urllib.error.URLError, TimeoutError) as error:
            raise RuntimeError(f"Could not reach Granola MCP: {error}")
        return parse_body(text)

    def initialize(self) -> None:
        self.next_id = 1
        result = self.post(
            {
                "jsonrpc": "2.0",
                "id": self.next_id,
                "method": "initialize",
                "params": {
                    "protocolVersion": self.protocol,
                    "capabilities": {},
                    "clientInfo": {"name": "meeting-notes", "version": "0.1"},
                },
            }
        )
        if result and result.get("result", {}).get("protocolVersion"):
            self.protocol = result["result"]["protocolVersion"]
        self.next_id += 1
        self.post(
            {
                "jsonrpc": "2.0",
                "method": "notifications/initialized",
            }
        )

    def call(self, method: str, params: dict | None = None) -> dict:
        self.next_id += 1
        result = self.post(
            {
                "jsonrpc": "2.0",
                "id": self.next_id,
                "method": method,
                "params": params or {},
            }
        )
        if not result:
            raise RuntimeError("Granola MCP returned an empty response")
        if "error" in result:
            raise RuntimeError(str(result["error"]))
        return result.get("result", {})

    def tools(self) -> list:
        return self.call("tools/list").get("tools", [])


def status() -> int:
    client = Mcp(token())
    client.initialize()
    result = client.call("tools/call", {"name": "get_account_info", "arguments": {}})
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


def main() -> int:
    if "--connect" in sys.argv:
        return connect()
    if "--token" in sys.argv:
        print(token())
        return 0
    if "--status" in sys.argv:
        return status()
    if "--tools" in sys.argv:
        client = Mcp(token())
        client.initialize()
        print(json.dumps(client.tools(), indent=2, ensure_ascii=False))
        return 0
    if "--call" in sys.argv:
        index = sys.argv.index("--call")
        if index + 1 >= len(sys.argv):
            print("--call needs a tool name", file=sys.stderr)
            return 2
        name = sys.argv[index + 1]
        arguments = {}
        if index + 2 < len(sys.argv):
            try:
                arguments = json.loads(sys.argv[index + 2])
            except ValueError:
                print("--call arguments must be JSON", file=sys.stderr)
                return 2
        client = Mcp(token())
        client.initialize()
        print(json.dumps(
            client.call("tools/call", {"name": name, "arguments": arguments}),
            indent=2, ensure_ascii=False))
        return 0
    print("Usage: granola-oauth --connect | --status | --token | --tools | --call NAME [JSON]",
          file=sys.stderr)
    return 2


if __name__ == "__main__":
    os.umask(0o077)
    try:
        raise SystemExit(main())
    except (RuntimeError, urllib.error.URLError, TimeoutError) as error:
        print(f"granola-oauth: {error}", file=sys.stderr)
        raise SystemExit(1)
